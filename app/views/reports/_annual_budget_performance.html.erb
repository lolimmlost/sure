<%# locals: (annual_plan:, start_date:, end_date:, **args) %>

<% if annual_plan.category_summaries.any? %>
  <%
    expense_summaries = annual_plan.expense_category_summaries
    savings_summaries = annual_plan.savings_category_summaries
    expense_budget_total = expense_summaries.sum(&:annual_budget)
    expense_period_total = expense_summaries.sum(&:period_actual)
    expense_remaining_total = expense_budget_total - expense_period_total

    # Determine the actual column label based on period scope
    if annual_plan.period_scoped?
      actual_label = t("reports.annual_budget_performance.period_actual")
    else
      actual_label = t("reports.annual_budget_performance.ytd_actual")
    end
  %>

  <div class="space-y-4">
    <%# Summary cards %>
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="bg-container-inset rounded-xl p-4">
        <p class="text-xs font-medium text-secondary uppercase tracking-wide mb-1">
          <%= t("reports.annual_budget_performance.annual_budget") %>
        </p>
        <p class="text-lg font-semibold text-primary">
          <%= format_money Money.new(expense_budget_total, annual_plan.currency) %>
        </p>
      </div>
      <div class="bg-container-inset rounded-xl p-4">
        <p class="text-xs font-medium text-secondary uppercase tracking-wide mb-1">
          <%= actual_label %>
        </p>
        <p class="text-lg font-semibold text-primary">
          <%= format_money Money.new(expense_period_total, annual_plan.currency) %>
        </p>
      </div>
      <div class="bg-container-inset rounded-xl p-4">
        <p class="text-xs font-medium text-secondary uppercase tracking-wide mb-1">
          <%= t("reports.annual_budget_performance.remaining") %>
        </p>
        <p class="text-lg font-semibold <%= expense_remaining_total >= 0 ? "text-success" : "text-destructive" %>">
          <%= format_money Money.new(expense_remaining_total, annual_plan.currency) %>
        </p>
      </div>
      <div class="bg-container-inset rounded-xl p-4">
        <p class="text-xs font-medium text-secondary uppercase tracking-wide mb-1">
          <%= t("reports.annual_budget_performance.savings_rate") %>
        </p>
        <p class="text-lg font-semibold <%= annual_plan.savings_rate >= 0 ? "text-success" : "text-destructive" %>">
          <%= number_to_percentage(annual_plan.savings_rate, precision: 1) %>
        </p>
      </div>
    </div>

    <%# Expense categories table %>
    <% if expense_summaries.any? %>
      <div class="bg-container-inset rounded-xl p-1 overflow-x-auto">
        <div class="w-max sm:w-full">
          <div class="rounded-lg shadow-border-xs bg-container overflow-hidden">
            <table class="w-full">
            <thead class="bg-container-inset">
              <tr class="uppercase text-xs font-medium text-secondary">
                <th class="px-4 py-2 text-left font-medium"><%= t("reports.annual_budget_performance.category") %></th>
                <th class="px-4 py-2 text-right font-medium whitespace-nowrap"><%= t("reports.annual_budget_performance.annual_budget") %></th>
                <th class="px-4 py-2 text-right font-medium whitespace-nowrap"><%= actual_label %></th>
                <th class="px-4 py-2 text-right font-medium whitespace-nowrap"><%= t("reports.annual_budget_performance.remaining") %></th>
                <th class="px-4 py-2 font-medium min-w-[100px]"></th>
              </tr>
            </thead>
            <tbody class="text-secondary text-sm">
              <% expense_summaries.each_with_index do |cs, idx| %>
                <%
                  period_spent = cs.period_actual
                  period_remaining = cs.annual_budget - period_spent
                  period_pct = cs.annual_budget.positive? ? (period_spent / cs.annual_budget.to_f * 100).round(1) : 0
                  period_status = if period_pct > 100
                    :over_budget
                  elsif period_pct > 80
                    :warning
                  else
                    :on_track
                  end
                %>
                <tr class="<%= idx < expense_summaries.size - 1 ? "table-divider" : "" %>">
                  <td class="py-3 px-4 lg:px-6">
                    <div class="flex items-center gap-2 whitespace-nowrap">
                      <div class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= cs.color %>"></div>
                      <span class="text-primary font-medium"><%= cs.name %></span>
                      <% if cs.budget_category.non_monthly? %>
                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-container-inset text-secondary font-medium shrink-0">
                          <%= cs.frequency_label %>
                        </span>
                      <% end %>
                    </div>
                  </td>
                  <td class="py-3 px-4 lg:px-6 text-right text-secondary whitespace-nowrap privacy-sensitive">
                    <%= format_money Money.new(cs.annual_budget, cs.currency) %>
                  </td>
                  <td class="py-3 px-4 lg:px-6 text-right text-primary font-medium whitespace-nowrap privacy-sensitive">
                    <%= format_money Money.new(period_spent, cs.currency) %>
                  </td>
                  <td class="py-3 px-4 lg:px-6 text-right font-medium whitespace-nowrap privacy-sensitive <%= period_remaining >= 0 ? "text-success" : "text-destructive" %>">
                    <%= format_money Money.new(period_remaining, cs.currency) %>
                  </td>
                  <td class="py-3 px-4 lg:px-6 min-w-[100px]">
                    <div class="h-1.5 bg-container-inset rounded-full overflow-hidden">
                      <% bar_class = case period_status
                         when :over_budget then "bg-destructive"
                         when :warning then "bg-warning"
                         else "bg-success"
                         end %>
                      <div class="h-full rounded-full <%= bar_class %>"
                           style="width: <%= [period_pct, 100].min %>%"></div>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          </div>
        </div>
      </div>
    <% end %>

    <%# Savings categories %>
    <% if savings_summaries.any? %>
      <div class="text-large mb-2 flex items-center gap-2 text-lg">
        <%= icon("piggy-bank", class: "w-5 h-5") %>
        <span><%= t("reports.annual_budget_performance.savings") %></span>
      </div>

      <div class="bg-container-inset rounded-xl p-1 overflow-x-auto">
        <div class="w-max sm:w-full">
          <div class="bg-container rounded-lg shadow-border-xs overflow-hidden">
            <table class="w-full">
              <tbody class="text-secondary text-sm">
                <% savings_summaries.each_with_index do |cs, idx| %>
                <%
                  savings_period_spent = cs.period_actual
                  savings_remaining = cs.annual_budget - savings_period_spent
                  savings_pct = cs.annual_budget.positive? ? (savings_period_spent / cs.annual_budget.to_f * 100).round(1) : 0
                %>
                <tr class="<%= idx < savings_summaries.size - 1 ? "table-divider" : "" %>">
                  <td class="py-3 px-4 lg:px-6">
                    <div class="flex items-center gap-2 whitespace-nowrap">
                      <div class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= cs.color %>"></div>
                      <span class="text-primary font-medium"><%= cs.name %></span>
                    </div>
                  </td>
                  <td class="py-3 px-4 lg:px-6 text-right text-secondary whitespace-nowrap privacy-sensitive">
                    <%= format_money Money.new(cs.annual_budget, cs.currency) %>
                  </td>
                  <td class="py-3 px-4 lg:px-6 text-right text-success font-medium whitespace-nowrap privacy-sensitive">
                    <%= format_money Money.new(savings_period_spent, cs.currency) %>
                  </td>
                  <td class="py-3 px-4 lg:px-6 text-right text-secondary whitespace-nowrap privacy-sensitive">
                    <% if savings_remaining.negative? %>
                      <span class="text-success font-medium"><%= format_money Money.new(savings_remaining.abs, cs.currency) %> extra</span>
                    <% else %>
                      <%= format_money Money.new(savings_remaining, cs.currency) %> left
                    <% end %>
                  </td>
                  <td class="py-3 px-4 lg:px-6 min-w-[100px]">
                    <div class="h-1.5 bg-container-inset rounded-full overflow-hidden">
                      <div class="h-full rounded-full bg-success"
                           style="width: <%= [savings_pct, 100].min %>%"></div>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          </div>
        </div>
      </div>
    <% end %>

    <%# Link to full annual plan %>
    <div class="mt-2">
      <%= render DS::Link.new(
        text: t("reports.annual_budget_performance.view_annual_plan"),
        variant: "ghost",
        href: annual_budgets_path(year: annual_plan.year),
        icon: "arrow-right"
      ) %>
    </div>
  </div>
<% else %>
  <div class="py-8 text-center">
    <p class="text-sm text-secondary"><%= t("reports.annual_budget_performance.no_data") %></p>
  </div>
<% end %>
